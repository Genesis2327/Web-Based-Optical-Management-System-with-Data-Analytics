-- Example SQL file for updating product descriptions
-- Generated by GENERATE_PRODUCT_DESCRIPTIONS.php or artisan products:generate-descriptions --output-sql
-- 
-- Usage:
-- 1. Generate descriptions: php artisan products:generate-descriptions --output-sql > update_descriptions.sql
-- 2. Review the SQL file
-- 3. Execute: mysql -u username -p database_name < update_descriptions.sql
--    OR in MySQL: source update_descriptions.sql;

-- Example UPDATE statements:
-- UPDATE products SET description = 'Modern rectangular eyeglass frames in sleek black acetate. Features a bold, contemporary design perfect for professional settings.' WHERE id = 1;
-- UPDATE products SET description = 'Classic Aviator Sunglasses by Ray-Ban. Featuring rectangular shape, black color, metal frame. A quality optical product perfect for your vision needs.' WHERE id = 2;

-- Start transaction for safety
START TRANSACTION;

